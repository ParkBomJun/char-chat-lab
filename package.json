{
  "name": "char-chat-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "eval": "tsx eval/run.ts all",
    "eval:scenarios": "tsx eval/run.ts scenarios",
    "eval:redteam": "tsx eval/run.ts redteam",
    "predeploy": "tsx scripts/predeploy.ts",
    "db:test:up": "docker compose --profile test up -d --wait db-test",
    "db:test:reset": "docker compose --profile test up -d --force-recreate --wait db-test && tsx scripts/test-run.ts -- sh -c \"npx prisma migrate deploy && npx prisma db seed\"",
    "db:test:down": "docker compose --profile test stop db-test",
    "dev:test": "tsx scripts/test-run.ts -- next dev -p 3110",
    "test:leak": "tsx scripts/test-run.ts -- tsx scripts/e2e-leak-check.ts",
    "dev:test:real": "tsx scripts/test-run.ts --real -- next dev -p 3110",
    "eval:judge": "tsx eval/tools/judge-report.ts",
    "eval:convert": "tsx eval/tools/convert-redteam.ts",
    "redteam:all": "tsx eval/tools/redteam-all.ts",
    "metrics:backfill": "tsx scripts/metrics-backfill.ts",
    "cache:dump": "tsx scripts/cache-probe.ts dump",
    "tokens:calib": "tsx scripts/token-calib.ts",
    "cache:latency": "tsx scripts/cache-latency.ts",
    "cache:probe": "tsx scripts/cache-probe.ts probe"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
