# 복사해서 .env로 쓴다. .env는 커밋하지 않는다.

# --- DB (docker-compose.yml 기본값과 일치) ---
DATABASE_URL="postgresql://chatlab:chatlab@localhost:5433/chatlab?schema=public"

# --- 인증 ---
AUTH_SECRET=""   # openssl rand -base64 32

# --- LLM (OpenAI 호환 API, 2단계에서 사용) ---
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_CHAT_MODEL=""        # 대화용 모델
LLM_CLASSIFIER_MODEL=""  # 안전 분류기·요약용 저가 모델
# 키가 비어 있으면 자동으로 mock 어댑터(가짜 응답). 키가 있어도 mock을 쓰려면 아래를 켠다.
# LLM_PROVIDER="mock"

# --- 대화 설정 (SPEC 3장 기본값) ---
RECENT_TURNS=20
SUMMARY_EVERY=10
LOREBOOK_SCAN_TURNS=4
DAILY_MESSAGE_LIMIT=50
# 프롬프트 입력 전체 예산. 단위는 실제 토큰이 아니라 추정 토큰 = 글자 수다(실제 토큰은 약 0.55배: 20000 ≈ 실제 11,000토큰).
# 고정 블록(안전 지시 + 카드 + 작은 로어북)은 자르지 않으므로, 이 값이 카드보다 작으면 최근 대화가 전부 잘린다.
# 기본 캐릭터의 고정 블록이 7,976자, 관리자 화면 한도를 다 채운 카드가 약 11,300자다. 카드에 비해 작으면 predeploy가 오류를 내고 관리자 화면이 경고한다.
PROMPT_TOKEN_BUDGET=20000
LOREBOOK_TOKEN_BUDGET=800     # 키워드 로어북 블록 예산(같은 단위: 글자 수)
# 캐시 옵션(docs/CACHE.md). 명시적 캐시(cache_control)는 OpenRouter+Gemini에서 실측 확인, 주소가 openrouter.ai일 때만 전송된다.
# CACHE_BREAKPOINT=0        끄기(기본 1=켬). 켜면 이번 입력 직전의 마지막 안정 메시지에 cache_control 부착(앞부분이 CACHE_MIN_TOKENS 미만이면 생략)
# CACHE_MIN_TOKENS=3500
# LOREBOOK_INLINE_MAX_TOKENS=1000   활성 로어북 전체의 추정 토큰이 이 값 이하면 고정 블록에 상시 포함(캐시가 로어북 때문에 다시 만들어지지 않는다). 0이면 항상 키워드 방식
# CACHE_BREAKPOINT_POSITION=fixedBlock   표시 위치: fixedBlock(기본, 고정 블록 끝에 고정. 지연 우선) | beforeInput(이번 입력 직전. 비용 우선, 매 턴 첫 토큰 약 +3초) | stepped(이력이 CACHE_STEP_TOKENS만큼 늘 때만 옮김, LOREBOOK_POSITION=beforeInput과 함께). 비교는 docs/CACHE.md
# CACHE_STEP_TOKENS=1500
# LOREBOOK_POSITION=beforeInput   afterFixed(기본, 고정 블록 뒤) | beforeInput(최근 대화 뒤, 이번 입력 바로 앞)
MAX_OUTPUT_TOKENS=1024

# --- 안전 파이프라인 (6단계) ---
CLASSIFIER_BLOCK_THRESHOLD=0.8   # 분류기 score가 이 이상이면 차단
CLASSIFIER_TIMEOUT_MS=8000       # 초과하면 실패 → 차단(fail closed)
CLASSIFIER_RETRIES=1             # timeout·429·5xx일 때 재시도 횟수(0=끔, 최대 2). provider_filter·parse_error·그 밖의 4xx는 재시도 안 함
CLASSIFIER_RETRY_DELAY_MS=300    # 재시도 전 대기
FLOW_WINDOW_TURNS=5              # 대화 흐름 감시: 최근 N턴 평균
FLOW_MIN_TURNS=2                 # 첫 경고 전 최소 턴 수
FLOW_WARN_THRESHOLD=0.5          # 평균이 이 이상이면 경고
FLOW_STOP_STRIKES=2              # 경고 뒤 이만큼 더 넘으면 대화 중단
QUALITY_MIN_HANGUL_RATIO=0.9     # 응답 품질 지표(기록·표시용, 차단 아님): 응답의 한글 비율이 이 값 미만이면 관리자 화면·평가 리포트에서 '외국어 섞임'으로 센다
# LLM_STRUCTURED_OUTPUT="off"    # 분류기는 기본으로 response_format json_schema(strict)를 쓴다. 제공사가 지원하지 않으면 끈다(OpenRouter는 미지원 제공사를 건너뛰도록 require_parameters를 붙이므로 미지원 모델은 오류→fail closed)
# JUDGE_MODEL=""                # 레드팀 자동 판정(npm run redteam:all) 모델. 분류기와 다른 모델이어야 한다. 비우면 자동 판정을 건너뛰고 경고
# REDTEAM_APPROVED=1            # 공격 케이스를 실제 모델에 보내는 평가를 허용. 제공사의 승인을 받은 경우에만 지정한다(OpenRouter는 승인 없는 레드팀 금지: https://openrouter.ai/docs/cookbook/evaluate-and-optimize/red-teaming)

# --- 데모 계정 (seed가 생성; 공개 배포 시 비밀번호는 별도로 정한다) ---
DEMO_EMAIL="demo@example.com"
DEMO_PASSWORD="demo-password-1234"

# --- 관리자 계정 (seed가 role=ADMIN으로 생성. 공개 배포 시 반드시 강한 비밀번호로 교체) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin-password-1234"

# --- 배포(9단계) ---
# 프록시/도메인 뒤에서 로그인이 동작하려면 둘 중 하나가 필요하다.
AUTH_TRUST_HOST="true"
# AUTH_URL="https://your-domain.example"
# 로그인·가입 시도 제한이 쓰는 클라이언트 IP: X-Forwarded-For의 오른쪽에서 N번째(앞단 프록시 개수). 직접 노출(프록시 없음)은 금지.
TRUST_PROXY_HOPS=1
# /privacy 페이지에 표시할 삭제 요청 연락처(선택)
# CONTACT_EMAIL="you@example.com"
# --- 공개 데모(docs/DEPLOY.md) ---
# 가입 스위치. false면 서버가 가입을 거부하고 /signup은 안내만 보여 준다. 공개 데모에서는 false(열려 있으면 계정을 계속 만들어 일일 한도를 피할 수 있다)
SIGNUP_ENABLED="true"
# true면 로그인 화면과, DEMO_EMAIL 계정으로 들어온 대화 화면에 "여러 사람이 같이 쓰는 계정" 안내를 보여 준다
DEMO_NOTICE="false"
# docker-compose.prod.yml이 앱 포트를 여는 주소. 서버에서는 127.0.0.1(밖으로는 프록시만 연다). 기본 0.0.0.0
# APP_BIND="127.0.0.1"
# docker-compose.proxy.yml(Caddy)의 사이트 주소. 로컬 검증은 localhost
# SITE_ADDRESS="your-name.region.cloudapp.azure.com"
# 운영 배포에서 seed가 기존 캐릭터·비밀번호를 덮어쓰지 않게 한다(docker-compose.prod.yml이 설정)
# SEED_PRESERVE=1
