// 스키마를 바꾸면 SPEC.md 4장도 같이 고친다.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Tier {
  FREE
  PRO
}

enum ConvStatus {
  ACTIVE
  WARNED
  STOPPED
}

enum MsgRole {
  USER
  ASSISTANT
  SYSTEM_NOTICE
}

enum UsageKind {
  CHAT
  SUMMARY
  CLASSIFIER
}

enum ModStage {
  INPUT
  OUTPUT_STREAM
  OUTPUT_FINAL
  CONVERSATION
}

enum ModLayer {
  RULE
  CLASSIFIER
}

enum Verdict {
  ALLOW
  BLOCK
  ERROR
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  tier          Tier           @default(FREE) // 2단계 라우팅용
  createdAt     DateTime       @default(now())
  conversations Conversation[]
}

model Character {
  id            String          @id @default(cuid())
  name          String
  tagline       String
  persona       String // 성격·배경
  speechStyle   String // 말투 규칙
  exampleDialog String // 예시 대화
  greeting      String // 첫 인사
  isPublished   Boolean         @default(true)
  lorebook      LorebookEntry[]
  conversations Conversation[]
  createdAt     DateTime        @default(now())
}

model LorebookEntry {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  keywords    String[]
  content     String
  priority    Int       @default(0)
  enabled     Boolean   @default(true)

  @@index([characterId])
}

model Conversation {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character       @relation(fields: [characterId], references: [id])
  status      ConvStatus      @default(ACTIVE)
  riskScore   Float           @default(0) // 대화 흐름 감시 누적 점수
  messages    Message[]
  summaries   MemorySummary[]
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MsgRole
  content        String
  retracted      Boolean      @default(false) // 출력 검사로 회수된 경우
  metric         ResponseMetric?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// ASSISTANT 응답의 품질 지표(모델 호출 없이 글자만 보고 계산). 기록용이며 차단·재생성에 쓰지 않는다. 회수된 메시지는 저장하지 않는다.
model ResponseMetric {
  id               String   @id @default(cuid())
  messageId        String   @unique
  message          Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId   String
  characterId      String
  /// 글자(공백·문장부호·숫자 제외) 중 한글 비율. 글자가 없으면 NULL
  hangulRatio      Float?
  hasForeignScript Boolean  @default(false)
  /// 한글·라틴 외 문자 종류(han, kana, cyrillic, …)
  foreignScripts   String[]
  /// 괄호 안 행동 묘사 문구(앞뒤 공백 제거)
  actionPhrases    String[]
  length           Int
  paragraphs       Int
  endsWithQuestion Boolean
  /// 메시지 시각(기간 필터 기준)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([characterId, createdAt])
}

model MemorySummary {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String
  coversUntilMsg String // 어느 메시지까지 요약했는지 (Message.id)
  version        Int
  createdAt      DateTime     @default(now())

  @@unique([conversationId, version])
}

model UsageLog {
  id                String    @id @default(cuid())
  userId            String
  conversationId    String
  kind              UsageKind
  model             String
  inputTokens       Int
  cachedInputTokens Int       @default(0)
  outputTokens      Int
  usageEstimated    Boolean   @default(false) // true면 제공사 usage가 없어 글자 수로 추정한 값
  estCost           Decimal // 단가표 기반 추정(비교용)
  actualCost        Decimal? // 제공사 usage.cost(실제 청구액). 있으면 비용 표시에서 우선
  ttftMs            Int? // 첫 토큰까지
  totalMs           Int
  retryCount        Int       @default(0) // 분류기 호출을 재시도한 횟수(CLASSIFIER 행만 의미 있음)
  retryExtraMs      Int       @default(0) // 재시도로 늘어난 지연(ms). totalMs는 마지막 시도만 잰다
  blockTokens       Json? // 조립기가 추정한 블록별 토큰(fixed/summary/lorebook/recent/input/total)
  createdAt         DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
}

model ModerationEvent {
  id                String   @id @default(cuid())
  conversationId    String
  messageId         String?
  stage             ModStage
  layer             ModLayer
  verdict           Verdict
  category          String?
  score             Float?
  action            String // none | blocked | retracted | warned | stopped | crisis_notice
  /// verdict=ERROR일 때만: http_status | provider_filter | parse_error | timeout (분류 불가면 NULL). 원문은 저장하지 않는다.
  errorKind         String?
  httpStatus        Int?
  /// 분류기 응답의 finish_reason(코드값만)
  finishReason      String?
  /// errorKind=parse_error일 때만: 응답 모양(원문은 저장하지 않는다)
  responseLength    Int?
  startsWithBrace   Boolean?
  hasCodeFence      Boolean?
  hasRefusalPattern Boolean?
  /// 분류기가 차단(verdict=BLOCK, layer=CLASSIFIER)했을 때만: VERDICT_ONLY | SCORE_ONLY | BOTH. 규칙·흐름 차단과 그 밖의 행은 NULL
  decisionSource    String?
  /// 분류기 호출 재시도 횟수와, 재시도로 늘어난 지연(ms). 재시도가 없으면 0/NULL
  retryCount        Int      @default(0)
  retryExtraMs      Int?
  createdAt         DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([stage, verdict])
}

/// 로그인 실패·가입 시도 제한용 기록. 서버가 여러 대여도 공유되도록 DB에 둔다(메모리 카운터는 인스턴스마다 따로라 우회된다).
model RateLimitEvent {
  id        String   @id @default(cuid())
  scope     String // "login_fail" | "signup"
  key       String // 이메일|IP 조합 또는 IP
  createdAt DateTime @default(now())

  @@index([scope, key, createdAt])
}

/// 관리자 화면에서 바꾸는 런타임 설정(LLM 키·모델·단가). 값은 JSON 문자열이며 API 키는 암호화되어 들어간다.
model AppSetting {
  key       String   @id // 예: "llm"
  value     String
  updatedAt DateTime @updatedAt
}
