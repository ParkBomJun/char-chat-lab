// 스키마를 바꾸면 SPEC.md 4장도 같이 고친다.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Tier {
  FREE
  PRO
}

enum ConvStatus {
  ACTIVE
  WARNED
  STOPPED
}

enum MsgRole {
  USER
  ASSISTANT
  SYSTEM_NOTICE
}

enum UsageKind {
  CHAT
  SUMMARY
  CLASSIFIER
}

enum ModStage {
  INPUT
  OUTPUT_STREAM
  OUTPUT_FINAL
  CONVERSATION
}

enum ModLayer {
  RULE
  CLASSIFIER
}

enum Verdict {
  ALLOW
  BLOCK
  ERROR
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  tier          Tier           @default(FREE) // 2단계 라우팅용
  createdAt     DateTime       @default(now())
  conversations Conversation[]
}

model Character {
  id            String          @id @default(cuid())
  name          String
  tagline       String
  persona       String // 성격·배경
  speechStyle   String // 말투 규칙
  exampleDialog String // 예시 대화
  greeting      String // 첫 인사
  isPublished   Boolean         @default(true)
  lorebook      LorebookEntry[]
  conversations Conversation[]
  createdAt     DateTime        @default(now())
}

model LorebookEntry {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  keywords    String[]
  content     String
  priority    Int       @default(0)
  enabled     Boolean   @default(true)

  @@index([characterId])
}

model Conversation {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character       @relation(fields: [characterId], references: [id])
  status      ConvStatus      @default(ACTIVE)
  riskScore   Float           @default(0) // 대화 흐름 감시 누적 점수
  messages    Message[]
  summaries   MemorySummary[]
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MsgRole
  content        String
  retracted      Boolean      @default(false) // 출력 검사로 회수된 경우
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model MemorySummary {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String
  coversUntilMsg String // 어느 메시지까지 요약했는지 (Message.id)
  version        Int
  createdAt      DateTime     @default(now())

  @@unique([conversationId, version])
}

model UsageLog {
  id                String    @id @default(cuid())
  userId            String
  conversationId    String
  kind              UsageKind
  model             String
  inputTokens       Int
  cachedInputTokens Int       @default(0)
  outputTokens      Int
  usageEstimated    Boolean   @default(false) // true면 제공사 usage가 없어 글자 수로 추정한 값
  estCost           Decimal
  ttftMs            Int? // 첫 토큰까지
  totalMs           Int
  blockTokens       Json? // 조립기가 추정한 블록별 토큰(fixed/summary/lorebook/recent/input/total)
  createdAt         DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
}

model ModerationEvent {
  id             String   @id @default(cuid())
  conversationId String
  messageId      String?
  stage          ModStage
  layer          ModLayer
  verdict        Verdict
  category       String?
  score          Float?
  action         String // none | blocked | retracted | warned | stopped | crisis_notice
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([stage, verdict])
}

/// 로그인 실패·가입 시도 제한용 기록. 서버가 여러 대여도 공유되도록 DB에 둔다(메모리 카운터는 인스턴스마다 따로라 우회된다).
model RateLimitEvent {
  id        String   @id @default(cuid())
  scope     String // "login_fail" | "signup"
  key       String // 이메일|IP 조합 또는 IP
  createdAt DateTime @default(now())

  @@index([scope, key, createdAt])
}

/// 관리자 화면에서 바꾸는 런타임 설정(LLM 키·모델·단가). 값은 JSON 문자열이며 API 키는 암호화되어 들어간다.
model AppSetting {
  key       String   @id // 예: "llm"
  value     String
  updatedAt DateTime @updatedAt
}
