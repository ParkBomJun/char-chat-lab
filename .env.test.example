# 테스트·E2E 전용 환경. `cp .env.test.example .env.test` 후 사용한다. (.env.test는 커밋하지 않는다)
# scripts/test-run.ts(= npm run dev:test 등)가 이 파일을 읽어 개발용 .env 값을 덮어쓴다.
APP_ENV=test
# 개발 DB(5433/chatlab)와 분리된 테스트 DB. 이름은 반드시 _test로 끝나야 한다(아니면 앱이 시작을 거부).
DATABASE_URL="postgresql://chatlab:chatlab_test@localhost:5434/chatlab_test?schema=public"
AUTH_SECRET="test-only-secret-change-me-0123456789abcdef"

# 기본은 mock. 실제 호출은 `npm run dev:test:real`(ALLOW_REAL_LLM=1)에서만, 아래 키를 채웠을 때 일어난다.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_CLASSIFIER_MODEL=

DEMO_EMAIL="demo@example.com"
DEMO_PASSWORD="test-demo-password-1"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="test-admin-password-1"
DAILY_MESSAGE_LIMIT=50
TRUST_PROXY_HOPS=1
